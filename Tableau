// [Privileged Account Flag]
IF REGEXP_MATCH(
     LOWER([Samaccountname]),
     '^(?:!si|as|asi)[0-9]+$'
) THEN
    "Privileged Account"
ELSE "Standard Account"
END


###check if value start with.. using REGEX and replace start of string using REGEX

IF REGEXP_MATCH(
     LOWER(TRIM([Login])),
     '^(?:!si|as|asi)[0-9]+$'
) THEN
    // It's a privileged account: normalize the identity
    // Normalize "!si####" → "si####"
    IF STARTSWITH(LOWER(TRIM([Login])), '!si') THEN 
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^!si', 'si')
    ELSEIF
        // Normalize "as####" → "s####"
        STARTSWITH(LOWER(TRIM([Login])), 'as') THEN
        // Replace leading "as" with "s"
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^as', 's')

    ELSE
        // Normalize "asi####" → "si####"
        //STARTSWITH(LOWER(TRIM([[Login]])), 'as') THEN
        // Replace leading "asi" with "si"
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^asi', 'si')
    END
ELSE
    // Non-privileged use the original (lowercased) as the identity key
    LOWER(TRIM([Login]))
END

// Extracts e.g., "!si12345@abc" or "as987@iag" if it appears inside (...)
REGEXP_EXTRACT(
  //LOWER([Display Name]),
[Display Name],
 // '\(\s*((?:!si|as)[0-9]+@[a-z0-9]+)\s*\)'
'\(\s*((?:!si|as|s|ca|si)[0-9]+)\s*\)'
)


// [Display Suffix Extracted]

// Helper triggers (inline):
//  - Bracketed account: (...), where inside is !si|as + digits, optional "@"+alphanum
//  - Group words present: G_, Local Admin, LocalAdministrator, Administrator(s)

IF
    // Trigger A: account pattern inside parentheses
    REGEXP_MATCH(
      LOWER(TRIM([Display Name])),
  //    '.*\(\s*(?:!si|as|s|si)[0-9]+(?:@[a-z0-9]+)?\s*\).*'
      '.*\(\s*(?:!si|as|s|ca|si)[0-9]+?\s*\).*'
    )
    // OR Trigger B: group-related words present
    OR CONTAINS(UPPER([Display Name]), 'G_')
    OR CONTAINS(LOWER([Display Name]), 'local admin')
    OR CONTAINS(LOWER([Display Name]), 'localadministrator')
    OR CONTAINS(LOWER([Display Name]), 'administrators')
    OR CONTAINS(LOWER([Display Name]), 'administrator')

THEN
    // Prefer the " - " delimiter
    IF FIND([Display Name], ' - ') > 0 THEN
        TRIM( MID([Display Name], FIND([Display Name], ' - ') + 3) )

    // Fallback to the "): " delimiter
    ELSEIF FIND([Display Name], '): ') > 0 THEN
        TRIM( MID([Display Name], FIND([Display Name], '): ') + 3) )

    // If neither delimiter is present, just return the original
    ELSE
        [Display Name]
    END

ELSE
    // No trigger → leave as-is
    [Display Name]
END

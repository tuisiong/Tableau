// [Privileged Account Flag]
IF REGEXP_MATCH(
     LOWER([Samaccountname]),
     '^(?:!si|as|asi)[0-9]+$'
) THEN
    "Privileged Account"
ELSE "Standard Account"
END


###check if value start with.. using REGEX and replace start of string using REGEX

IF REGEXP_MATCH(
     LOWER(TRIM([Login])),
     '^(?:!si|as|asi)[0-9]+$'
) THEN
    // It's a privileged account: normalize the identity
    // Normalize "!si####" → "si####"
    IF STARTSWITH(LOWER(TRIM([Login])), '!si') THEN 
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^!si', 'si')
    ELSEIF
        // Normalize "as####" → "s####"
        STARTSWITH(LOWER(TRIM([Login])), 'as') THEN
        // Replace leading "as" with "s"
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^as', 's')

    ELSE
        // Normalize "asi####" → "si####"
        //STARTSWITH(LOWER(TRIM([[Login]])), 'as') THEN
        // Replace leading "asi" with "si"
        REGEXP_REPLACE(LOWER(TRIM([Login])), '^asi', 'si')
    END
ELSE
    // Non-privileged use the original (lowercased) as the identity key
    LOWER(TRIM([Login]))
END

// Extracts e.g., "!si12345@abc" or "as987@iag" if it appears inside (...)
REGEXP_EXTRACT(
  //LOWER([Display Name]),
[Display Name],
 // '\(\s*((?:!si|as)[0-9]+@[a-z0-9]+)\s*\)'
'\(\s*((?:!si|as|s|ca|si)[0-9]+)\s*\)'
)



// [Display Suffix Extracted (Trigger A with Role nuance)]

// Trigger A regex: (...) contains !si|as + digits, optional "@"+alphanum (case-insensitive via LOWER)
IF REGEXP_MATCH(
       LOWER(TRIM([Display Name])),
      // '.*\(\s*(?:!si|as)[0-9]+(?:@[a-z0-9]+)?\s*\).*'
      '.*\(\s*(?:!si|as|s|ca|si)[0-9]+?\s*\).*'
   ) THEN

    // Secondary check for role words (case-insensitive)
    IF CONTAINS(LOWER([Display Name]), 'individual role')
       OR CONTAINS(LOWER([Display Name]), 'application role')
    THEN
        // Need the substring after the SECOND " - "
        IF FIND([Display Name], ' - ') > 0 THEN
            // Find the second occurrence starting after the first one
            IF FIND([Display Name], ' - ', FIND([Display Name], ' - ') + 3) > 0 THEN
                TRIM(
                    MID(
                        [Display Name],
                        FIND([Display Name], ' - ', FIND([Display Name], ' - ') + 3) + 3
                    )
                )
            ELSE
                // Only one " - " present → fall back to after the first " - "
                TRIM( MID([Display Name], FIND([Display Name], ' - ') + 3) )
            END
        // No " - " → fall back to after "): "
        ELSEIF FIND([Display Name], '): ') > 0 THEN
            TRIM( MID([Display Name], FIND([Display Name], '): ') + 3) )
        ELSE
            // No delimiters → return original
            [Display Name]
        END

    ELSE
        // Trigger A matched, but no role words → use the standard first-delimiter rule
        IF FIND([Display Name], ' - ') > 0 THEN
            TRIM( MID([Display Name], FIND([Display Name], ' - ') + 3) )
        ELSEIF FIND([Display Name], '): ') > 0 THEN
            TRIM( MID([Display Name], FIND([Display Name], '): ') + 3) )
        ELSE
            [Display Name]
        END
    END

// Trigger B: group/admin words without bracketed account
ELSEIF CONTAINS(UPPER([Display Name]), 'G_')
    OR CONTAINS(LOWER([Display Name]), 'adms_')
    OR CONTAINS(LOWER([Display Name]), 'local admin')
    OR CONTAINS(LOWER([Display Name]), 'localadministrator')
    OR CONTAINS(LOWER([Display Name]), 'administrators')  // check plural first
    OR CONTAINS(LOWER([Display Name]), 'administrator')   // then singular
THEN
    IF FIND([Display Name], ' - ') > 0 THEN
        TRIM( MID([Display Name], FIND([Display Name], ' - ') + 3) )
    ELSEIF FIND([Display Name], '): ') > 0 THEN
        TRIM( MID([Display Name], FIND([Display Name], '): ') + 3) )
    ELSE
        [Display Name]
    END

// Default: return original
ELSE
    [Display Name]
END


ELSE
    // No trigger → leave as-is
    [Display Name]
END



